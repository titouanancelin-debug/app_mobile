# Copie ce fichier vers `.env` (qui est gitignoré) et remplis les valeurs.
# Les variables EXPO_PUBLIC_* sont lues automatiquement par Expo au démarrage
# et injectées dans le code JS (redémarre `npx expo start` après modification).

# --- Spotify (https://developer.spotify.com/dashboard) ---
# Dashboard → ton app → Settings → Client ID
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=

# --- Firebase (https://console.firebase.google.com) ---
# Console → ton projet → ⚙️ Paramètres → Vos applications → app Web → firebaseConfig
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
